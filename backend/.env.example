# CareFlow AI Backend - Environment Configuration
# NEVER commit the real .env file to version control.

GEMINI_API_KEY=
PORT=8000
HOST=0.0.0.0

# MySQL Database
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=careflow_db

# Email Service Configuration (Optional for real SMTP dispatch; falls back to safe simulation mode if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@domain.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="CareFlow Medical Center"
CLINIC_NAME="CareFlow Memorial Hospital"
CLINIC_PHONE="+91 800 227 3356"
