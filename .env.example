# CareFlow AI - Environment Variables Configuration
# Copy this file to .env and configure credentials.
# NEVER commit the real .env file or credentials to version control!

# Gemini AI (Structured patient-friendly email synthesis)
GEMINI_API_KEY=

# SMTP Server Configuration (Production Email Delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@domain.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="CareFlow AI Coordinator"
CLINIC_NAME="CareFlow Memorial Hospital"
CLINIC_PHONE="+91 800 227 3356"

# SMS Gateway Configuration (DLT Pre-Approved SMS)
SMS_API_URL=https://api.sms-provider.com/v1/send
SMS_API_KEY=
SMS_SENDER_ID=CRFLOW

# Database Connection (MySQL / SQLite fallback)
DATABASE_URL=sqlite:///./careflow.db

# EmailJS Browser Integration (Contact & Notifications)
# Template ID: template_k7sqdk9
VITE_EMAILJS_SERVICE_ID=service_nhiqrmi
VITE_EMAILJS_PUBLIC_KEY=Ioj9Q5HLktFP5mI3X
VITE_EMAILJS_TEMPLATE_ID=template_k7sqdk9

# Server Configuration
PORT=8000
HOST=0.0.0.0


